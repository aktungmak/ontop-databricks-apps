  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:shipMode ;
    rr:objectMap [ rr:column "l_shipmode" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:comment ;
    rr:objectMap [ rr:column "l_comment" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:partOfOrder ;
    rr:objectMap [
      rr:parentTriplesMap <#Order> ;
      rr:joinCondition [
        rr:child "l_orderkey" ;
        rr:parent "o_orderkey"
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:ofPart ;
    rr:objectMap [
      rr:parentTriplesMap <#Part> ;
      rr:joinCondition [
        rr:child "l_partkey" ;
        rr:parent "p_partkey"
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:lineSuppliedBy ;
    rr:objectMap [
      rr:parentTriplesMap <#Supplier> ;
      rr:joinCondition [
        rr:child "l_suppkey" ;
        rr:parent "s_suppkey"
      ]
    ]
  ] .
