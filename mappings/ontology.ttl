@prefix ex: <http://example.org/tpch/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
  rdfs:label "Decision support ontology" ;
  rdfs:comment "Ontology for the Decision support system at Acme Corporation." .

### Classes

ex:Customer a owl:Class ;
  rdfs:label "Customer" ;
  skos:altLabel "Buyer", "Client", "Account" ;
  rdfs:comment "An Acme customer who places orders." .

ex:Order a owl:Class ;
  rdfs:label "Order" ;
  skos:altLabel "Purchase order", "Sales order", "Transaction" ;
  rdfs:comment "A customer order consisting of one or more line items." .

ex:LineItem a owl:Class ;
  rdfs:label "Line item" ;
  skos:altLabel "Order line", "Order detail", "Line" ;
  rdfs:comment "A single line on an order, referencing a part and supplier." .

ex:Part a owl:Class ;
  rdfs:label "Part" ;
  skos:altLabel "Product", "Item", "SKU", "Article" ;
  rdfs:comment "A product that can be ordered and stocked by suppliers." .

ex:Supplier a owl:Class ;
  rdfs:label "Supplier" ;
  skos:altLabel "Vendor", "Provider", "Seller" ;
  rdfs:comment "A vendor that supplies parts." .

ex:PartSupp a owl:Class ;
  rdfs:label "Part supply" ;
  skos:altLabel "Part supplier", "Inventory", "Stock", "Availability" ;
  rdfs:comment "Availability and cost of a part from a specific supplier." .

ex:Nation a owl:Class ;
  rdfs:label "Nation" ;
  skos:altLabel "Country", "State" ;
  rdfs:comment "A nation in which customers and suppliers are located." .

ex:Region a owl:Class ;
  rdfs:label "Region" ;
  skos:altLabel "Area", "Territory", "Geography" ;
  rdfs:comment "A geographic region containing one or more nations." .

### Object properties — order / line item

ex:placedBy a owl:ObjectProperty ;
  rdfs:label "placed by" ;
  rdfs:domain ex:Order ;
  rdfs:range ex:Customer ;
  owl:inverseOf ex:placesOrder .

ex:placesOrder a owl:ObjectProperty ;
  rdfs:label "places order" ;
  rdfs:domain ex:Customer ;
  rdfs:range ex:Order .

ex:partOfOrder a owl:ObjectProperty ;
  rdfs:label "part of order" ;
  rdfs:domain ex:LineItem ;
  rdfs:range ex:Order ;
  owl:inverseOf ex:hasLineItem .

ex:hasLineItem a owl:ObjectProperty ;
  rdfs:label "has line item" ;
  rdfs:domain ex:Order ;
  rdfs:range ex:LineItem .

### Object properties — part / supplier on line items

ex:ofPart a owl:ObjectProperty ;
  rdfs:label "of part" ;
  rdfs:comment "The part referenced by a line item." ;
  rdfs:domain ex:LineItem ;
  rdfs:range ex:Part ;
  owl:inverseOf ex:orderedInLineItem .

ex:orderedInLineItem a owl:ObjectProperty ;
  rdfs:label "ordered in line item" ;
  rdfs:domain ex:Part ;
  rdfs:range ex:LineItem .

ex:lineSuppliedBy a owl:ObjectProperty ;
  rdfs:label "line supplied by" ;
  rdfs:comment "The supplier fulfilling a line item." ;
  rdfs:domain ex:LineItem ;
  rdfs:range ex:Supplier ;
  owl:inverseOf ex:suppliesLineItem .

ex:suppliesLineItem a owl:ObjectProperty ;
  rdfs:label "supplies line item" ;
  rdfs:domain ex:Supplier ;
  rdfs:range ex:LineItem .

### Object properties — part / supplier availability

ex:forPart a owl:ObjectProperty ;
  rdfs:label "for part" ;
  rdfs:domain ex:PartSupp ;
  rdfs:range ex:Part ;
  owl:inverseOf ex:hasPartSupply .

ex:hasPartSupply a owl:ObjectProperty ;
  rdfs:label "has part supply" ;
  rdfs:domain ex:Part ;
  rdfs:range ex:PartSupp .

ex:bySupplier a owl:ObjectProperty ;
  rdfs:label "by supplier" ;
  rdfs:domain ex:PartSupp ;
  rdfs:range ex:Supplier ;
  owl:inverseOf ex:hasSupplierSupply .

ex:hasSupplierSupply a owl:ObjectProperty ;
  rdfs:label "has supplier supply" ;
  rdfs:domain ex:Supplier ;
  rdfs:range ex:PartSupp .

### Object properties — geography

ex:customerInNation a owl:ObjectProperty ;
  rdfs:label "customer in nation" ;
  rdfs:domain ex:Customer ;
  rdfs:range ex:Nation ;
  owl:inverseOf ex:hasCustomer .

ex:hasCustomer a owl:ObjectProperty ;
  rdfs:label "has customer" ;
  rdfs:domain ex:Nation ;
  rdfs:range ex:Customer .

ex:supplierInNation a owl:ObjectProperty ;
  rdfs:label "supplier in nation" ;
  rdfs:domain ex:Supplier ;
  rdfs:range ex:Nation ;
  owl:inverseOf ex:hasSupplier .

ex:hasSupplier a owl:ObjectProperty ;
  rdfs:label "has supplier" ;
  rdfs:domain ex:Nation ;
  rdfs:range ex:Supplier .

ex:inRegion a owl:ObjectProperty ;
  rdfs:label "in region" ;
  rdfs:domain ex:Nation ;
  rdfs:range ex:Region ;
  owl:inverseOf ex:hasNation .

ex:hasNation a owl:ObjectProperty ;
  rdfs:label "has nation" ;
  rdfs:domain ex:Region ;
  rdfs:range ex:Nation .

### Shared datatype properties

ex:name a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Customer ex:Supplier ex:Nation ex:Region ex:Part )
  ] ;
  rdfs:range xsd:string .

ex:address a owl:DatatypeProperty ;
  rdfs:label "address" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Customer ex:Supplier )
  ] ;
  rdfs:range xsd:string .

ex:phone a owl:DatatypeProperty ;
  rdfs:label "phone" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Customer ex:Supplier )
  ] ;
  rdfs:range xsd:string .

ex:accountBalance a owl:DatatypeProperty ;
  rdfs:label "account balance" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Customer ex:Supplier )
  ] ;
  rdfs:range xsd:decimal .

ex:comment a owl:DatatypeProperty ;
  rdfs:label "comment" ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string .

### Identifier / foreign-key datatype properties

ex:custKey a owl:DatatypeProperty ;
  rdfs:label "customer key" ;
  rdfs:domain ex:Customer ;
  rdfs:range xsd:integer .

ex:orderKey a owl:DatatypeProperty ;
  rdfs:label "order key" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:integer .

ex:lineNumber a owl:DatatypeProperty ;
  rdfs:label "line number" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:integer .

ex:partKey a owl:DatatypeProperty ;
  rdfs:label "part key" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Part ex:LineItem ex:PartSupp )
  ] ;
  rdfs:range xsd:integer .

ex:supplierKey a owl:DatatypeProperty ;
  rdfs:label "supplier key" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Supplier ex:LineItem ex:PartSupp )
  ] ;
  rdfs:range xsd:integer .

ex:nationKey a owl:DatatypeProperty ;
  rdfs:label "nation key" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Nation ex:Customer ex:Supplier )
  ] ;
  rdfs:range xsd:integer .

ex:regionKey a owl:DatatypeProperty ;
  rdfs:label "region key" ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( ex:Region ex:Nation )
  ] ;
  rdfs:range xsd:integer .

### Customer datatype properties

ex:marketSegment a owl:DatatypeProperty ;
  rdfs:label "market segment" ;
  rdfs:domain ex:Customer ;
  rdfs:range xsd:string .

### Order datatype properties

ex:orderStatus a owl:DatatypeProperty ;
  rdfs:label "order status" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:string .

ex:totalPrice a owl:DatatypeProperty ;
  rdfs:label "total price" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:decimal .

ex:orderDate a owl:DatatypeProperty ;
  rdfs:label "order date" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:date .

ex:orderPriority a owl:DatatypeProperty ;
  rdfs:label "order priority" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:string .

ex:clerk a owl:DatatypeProperty ;
  rdfs:label "clerk" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:string .

ex:shipPriority a owl:DatatypeProperty ;
  rdfs:label "ship priority" ;
  rdfs:domain ex:Order ;
  rdfs:range xsd:integer .

### Line item datatype properties

ex:quantity a owl:DatatypeProperty ;
  rdfs:label "quantity" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:decimal .

ex:extendedPrice a owl:DatatypeProperty ;
  rdfs:label "extended price" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:decimal .

ex:discount a owl:DatatypeProperty ;
  rdfs:label "discount" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:decimal .

ex:tax a owl:DatatypeProperty ;
  rdfs:label "tax" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:decimal .

ex:returnFlag a owl:DatatypeProperty ;
  rdfs:label "return flag" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:string .

ex:lineStatus a owl:DatatypeProperty ;
  rdfs:label "line status" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:string .

ex:shipDate a owl:DatatypeProperty ;
  rdfs:label "ship date" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:date .

ex:commitDate a owl:DatatypeProperty ;
  rdfs:label "commit date" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:date .

ex:receiptDate a owl:DatatypeProperty ;
  rdfs:label "receipt date" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:date .

ex:shipInstruct a owl:DatatypeProperty ;
  rdfs:label "shipping instructions" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:string .

ex:shipMode a owl:DatatypeProperty ;
  rdfs:label "ship mode" ;
  rdfs:domain ex:LineItem ;
  rdfs:range xsd:string .

### Part datatype properties

ex:manufacturer a owl:DatatypeProperty ;
  rdfs:label "manufacturer" ;
  rdfs:domain ex:Part ;
  rdfs:range xsd:string .

ex:brand a owl:DatatypeProperty ;
  rdfs:label "brand" ;
  rdfs:domain ex:Part ;
  rdfs:range xsd:string .

ex:partType a owl:DatatypeProperty ;
  rdfs:label "part type" ;
  rdfs:comment "Part type string (p_type); named partType to avoid clashing with rdf:type." ;
  rdfs:domain ex:Part ;
  rdfs:range xsd:string .

ex:size a owl:DatatypeProperty ;
  rdfs:label "size" ;
  rdfs:domain ex:Part ;
  rdfs:range xsd:integer .

ex:container a owl:DatatypeProperty ;
  rdfs:label "container" ;
  rdfs:domain ex:Part ;
  rdfs:range xsd:string .

ex:retailPrice a owl:DatatypeProperty ;
  rdfs:label "retail price" ;
  rdfs:domain ex:Part ;
  rdfs:range xsd:decimal .

### Part supply datatype properties

ex:availableQuantity a owl:DatatypeProperty ;
  rdfs:label "available quantity" ;
  rdfs:domain ex:PartSupp ;
  rdfs:range xsd:integer .

ex:supplyCost a owl:DatatypeProperty ;
  rdfs:label "supply cost" ;
  rdfs:domain ex:PartSupp ;
  rdfs:range xsd:decimal .
